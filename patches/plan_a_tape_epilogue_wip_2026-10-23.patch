+
+// Epilogue of a Linear layer: target = gemm + (bias(row) + contribution).
+// The fused consumers (LayerNorm/SiLU) evaluate the same expression while the
+// producer value is already in a register, so no extra read-modify-write pass
+// over the GEMM result is required.  The association is identical to the
+// standalone epilogue kernel (`target += bias + contribution`).
+template<typename Precision>
+KOKKOS_INLINE_FUNCTION
+Precision affine_linear_epilogue_value(
+    const Precision raw,
+    const int sample,
+    const int column,
+    const bool conditioned_layer,
+    const bool row_conditioned,
+    const bool indexed_conditioned,
+    const int first_edge,
+    const Kokkos::View<Precision*> bias,
+    const Kokkos::View<const Precision**,Kokkos::LayoutRight>
+        row_contributions,
+    const Kokkos::View<const int*> source_edge_types,
+    const Kokkos::View<const int*> target_node_indices,
+    const Kokkos::View<const int*> node_types,
+    const Kokkos::View<const Precision**,Kokkos::LayoutRight>
+        source_contribution_table,
+    const Kokkos::View<const Precision**,Kokkos::LayoutRight>
+        target_contribution_table)
+{
+    Precision contribution=Precision(0);
+    if(conditioned_layer&&row_conditioned)
+        contribution=row_contributions(sample,column);
+    else if(conditioned_layer&&indexed_conditioned) {
+        const int edge=first_edge+sample;
+        const int target_node=target_node_indices(edge);
+        contribution=source_contribution_table(
+            source_edge_types(edge),column)
+            +target_contribution_table(node_types(target_node),column);
+    }
+    return raw+(bias(column)+contribution);
+}
 }
 
