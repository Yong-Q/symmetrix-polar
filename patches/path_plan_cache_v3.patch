+// V3 control plane: prepare the checkpoint-constant UVU path plans once.
+// Previously every SCF step and every reverse step copied four small views
+// device->host (24 stream synchronizations per evaluation).  The plans never
+// change after construction, so cache them on the host and pass const
+// references into the forward/reverse kernels.  This also makes the polar
+// pipeline pointer-stable for a future CUDA graph capture.
+template<typename Precision>
+void MaceNonlinearKokkosT<Precision>::prepare_polar_host_tables()
+{
+    if(polar_host_tables_ready) return;
+    auto copy_view=[&](const auto& view) {
+        auto mirror=Kokkos::create_mirror_view_and_copy(
+            Kokkos::HostSpace(),view);
+        using value_type=typename decltype(mirror)::value_type;
+        std::vector<value_type> values(mirror.size());
+        for(std::size_t index=0;index<values.size();++index)
+            values[index]=mirror.data()[index];
+        return values;
+    };
+    const int steps=polar_recursion_steps;
+    polar_host_dot_meta.resize(steps);
+    polar_host_tp_meta.resize(steps);
+    polar_host_dot_pw.resize(steps);
+    polar_host_tp_pw.resize(steps);
+    for(int step=0;step<steps;++step) {
+        auto& update=polar_updates[step];
+        polar_host_dot_meta[step]=copy_view(update.uvu_dot_meta);
+        polar_host_tp_meta[step]=copy_view(update.uvu_tp_meta);
+        polar_host_dot_pw[step]=copy_view(update.uvu_dot_path_weight);
+        polar_host_tp_pw[step]=copy_view(update.uvu_tp_path_weight);
+    }
+    polar_host_le_q_meta=copy_view(polar_le_q_meta);
+    polar_host_le_v_meta=copy_view(polar_le_v_meta);
+    polar_host_le_q_pw=copy_view(polar_le_q_path_weight);
+    polar_host_le_v_pw=copy_view(polar_le_v_path_weight);
+    polar_host_tables_ready=true;
+}
