+                        Precision(0),dx2);
+                    Kokkos::parallel_for("polar uvu gemm rev dx2",
+                        Kokkos::MDRangePolicy<Kokkos::Rank<2>>({0,0},
+                            {num_nodes,mul2}),
+                        KOKKOS_LAMBDA(int node,int v) {
+                            x2_adj(node,in2_off+v*d1+c)+=dx2(node,v);
+                        });
+                }
+            } else {
+                Kokkos::parallel_for("polar uvu gemm rev mode1",
+                    Kokkos::MDRangePolicy<Kokkos::Rank<2>>({0,0},
+                        {num_nodes,mul1}),
+                    KOKKOS_LAMBDA(int node,int u) {
