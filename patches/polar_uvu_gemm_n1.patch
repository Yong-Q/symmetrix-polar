+// =====================================================================================
+// N1: grouped FP64 path-GEMM UVU (docs/results/POLAR_UVU_GEMM_MICROBENCH.md).
+//
+// Forward:  Z_p[n,u] = sum_v X2_p[n,v] W_p[u,v]   (KokkosBlas DGEMM, "N","T")
+//           out[n,c] = mask[c] * sum_p pw_p*inv_sqrt(d1_p) * X1_p[n,..] . Z_p
+// Reverse:  dX1 uses the saved forward Z elementwise; dX2 is P @ W_p per path,
+//           with P = mixed_bar * X1 (mode0) or mixed_bar (mode1).  No atomics,
+//           path order ascending, one mask multiply, deterministic FP64.
+// All path tables of this checkpoint are dense 512x512; unsupported tables
+// fall back to the legacy kernels.
+// =====================================================================================
+template<typename Precision>
+bool MaceNonlinearKokkosT<Precision>::polar_uvu_gemm_supported(
+    const std::vector<int>& meta)
+{
+    const int paths=static_cast<int>(meta.size())/8;
+    if(paths<=0||paths>kPolarUvuGemmMaxPaths) return false;
+    int planes=0;
+    for(int p=0;p<paths;++p) {
+        const int mul1=meta[p*8+4],mul2=meta[p*8+5],
+            mode=meta[p*8+6],d1=meta[p*8+7];
+        if(mul1!=kPolarUvuGemmWidth||mul2!=kPolarUvuGemmWidth)
+            return false;
+        if(mode!=0&&mode!=1) return false;
+        if(d1!=1&&d1!=3) return false;
+        planes+=(mode==0)?d1:1;
+    }
+    return planes<=4;
+}
+
+template<typename Precision>
+int MaceNonlinearKokkosT<Precision>::polar_uvu_plane_count(
+    const std::vector<int>& meta)
+{
+    const int paths=static_cast<int>(meta.size())/8;
+    int planes=0;
+    for(int p=0;p<paths;++p)
+        planes+=(meta[p*8+6]==0)?meta[p*8+7]:1;
+    return planes;
+}
+
+template<typename Precision>
+void MaceNonlinearKokkosT<Precision>::polar_uvu_gemm_compute_z(
+    const int num_nodes,const std::vector<int>& meta,
+    Kokkos::View<Precision*> weight_view,
+    Kokkos::View<const Precision**,Kokkos::LayoutRight> x2,
+    const int plane_base)
+{
+    if constexpr(!std::is_same_v<Precision,double>) {
+        (void)num_nodes;(void)meta;(void)weight_view;(void)x2;(void)plane_base;
+        throw std::runtime_error("polar uvu gemm requires FP64.");
+    } else {
+        const int paths=static_cast<int>(meta.size())/8;
+        const int planes=polar_uvu_plane_count(meta);
+        if(static_cast<int>(polar_uvu_z_cache.extent(0))<plane_base+planes
+            ||static_cast<int>(polar_uvu_z_cache.extent(1))!=num_nodes
+            ||static_cast<int>(polar_uvu_z_cache.extent(2))<kPolarUvuGemmWidth)
+            throw std::runtime_error(
+                "polar uvu gemm: Z cache is not sized for this table.");
+        ensure_view(polar_uvu_x2_pack,polar_uvu_x2_pack_storage,4,
+            num_nodes,kPolarUvuGemmWidth);
+        auto pack=polar_uvu_x2_pack;
+        auto zcache=polar_uvu_z_cache;
+        // Pack the X2 operand planes.  d1=1 planes are contiguous slices of
+        // x2; d1=3 planes have stride 3 in the node-major [N,2048] tensor and
+        // must be materialised for BLAS.
+        int pack_offset=0;
+        for(int p=0;p<paths;++p) {
+            const int in2_off=meta[p*8+1],mode=meta[p*8+6],
+                d1=meta[p*8+7];
+            const int planes=(mode==0)?d1:1;
+            const int stride=(mode==0)?d1:1;
+            for(int c=0;c<planes;++c) {
+                const int dst=pack_offset+c;
+                const int src_offset=in2_off+((mode==0)?c:0);
+                Kokkos::parallel_for("polar uvu gemm pack",
+                    Kokkos::MDRangePolicy<Kokkos::Rank<2>>({0,0},
+                        {num_nodes,kPolarUvuGemmWidth}),
+                    KOKKOS_LAMBDA(int node,int v) {
+                        pack(dst,node,v)=x2(node,src_offset+v*stride);
+                    });
+            }
+            pack_offset+=planes;
+        }
+        // Z = X2_plane @ W^T (node-major [N,512] result).
+        int z_offset=plane_base;
+        pack_offset=0;
+        for(int p=0;p<paths;++p) {
+            const int w_off=meta[p*8+3],mul1=meta[p*8+4],
+                mul2=meta[p*8+5],mode=meta[p*8+6],d1=meta[p*8+7];
+            const int planes=(mode==0)?d1:1;
+            Kokkos::View<const Precision**,Kokkos::LayoutRight,
+                Kokkos::MemoryTraits<Kokkos::Unmanaged>> W(
+                    weight_view.data()+w_off,mul1,mul2);
+            for(int c=0;c<planes;++c) {
+                auto xp=Kokkos::subview(pack,pack_offset+c,
+                    Kokkos::ALL,Kokkos::ALL);
+                auto zp=Kokkos::subview(zcache,z_offset+c,
+                    Kokkos::ALL,Kokkos::ALL);
+                KokkosBlas::gemm("N","T",Precision(1),xp,W,
+                    Precision(0),zp);
+            }
+            pack_offset+=planes;
+            z_offset+=planes;
+        }
+    }
+}
+
+template<typename Precision>
+void MaceNonlinearKokkosT<Precision>::polar_uvu_gemm_forward(
+    const int num_nodes,const std::vector<int>& meta,
+    const std::vector<Precision>& path_weight,
+    Kokkos::View<Precision*> weight_view,
+    Kokkos::View<Precision*> mask_view,
+    Kokkos::View<const Precision**,Kokkos::LayoutRight> x1,
+    Kokkos::View<const Precision**,Kokkos::LayoutRight> x2,
+    Kokkos::View<Precision**,Kokkos::LayoutRight> output,
+    const int plane_base)
+{
+    if constexpr(!std::is_same_v<Precision,double>) {
+        (void)num_nodes;(void)meta;(void)path_weight;(void)weight_view;
+        (void)mask_view;(void)x1;(void)x2;(void)output;(void)plane_base;
+        throw std::runtime_error("polar uvu gemm requires FP64.");
+    } else {
+        const int paths=static_cast<int>(meta.size())/8;
+        polar_uvu_gemm_compute_z(num_nodes,meta,weight_view,x2,plane_base);
+        PolarUvuGemmPath plan[kPolarUvuGemmMaxPaths];
+        int z_offset=plane_base;
+        for(int p=0;p<paths;++p) {
+            const int mode=meta[p*8+6],d1=meta[p*8+7];
+            plan[p].in1_off=meta[p*8+0];
+            plan[p].in2_off=meta[p*8+1];
+            plan[p].out_off=meta[p*8+2];
+            plan[p].z_base=z_offset;
+            plan[p].mul1=meta[p*8+4];
+            plan[p].mul2=meta[p*8+5];
+            plan[p].mode=mode;
+            plan[p].d1=d1;
+            plan[p].pw=static_cast<double>(path_weight[p]);
+            plan[p].inv_sqrt=1.0/std::sqrt(static_cast<double>(d1));
+            z_offset+=(mode==0)?d1:1;
+        }
+        auto zcache=polar_uvu_z_cache;
+        auto mask=mask_view;
+        const int width=static_cast<int>(output.extent(1));
+        Kokkos::parallel_for("polar uvu gemm epilogue",
+            Kokkos::MDRangePolicy<Kokkos::Rank<2>>({0,0},{num_nodes,width}),
+            KOKKOS_LAMBDA(int node,int column) {
+                Precision acc=Precision(0);
+                for(int p=0;p<paths;++p) {
+                    const PolarUvuGemmPath path=plan[p];
+                    if(path.mode==0) {
+                        if(column<path.out_off
+                            ||column>=path.out_off+path.mul1)
+                            continue;
+                        const int u=column-path.out_off;
+                        Precision mixed=Precision(0);
+                        for(int c=0;c<path.d1;++c)
+                            mixed+=x1(node,path.in1_off+u*path.d1+c)
+                                *zcache(path.z_base+c,node,u);
+                        acc+=path.pw*path.inv_sqrt*mixed;
+                    } else {
+                        const int rel=column-path.out_off;
+                        if(rel<0||rel>=path.mul1*path.d1) continue;
+                        const int u=rel/path.d1,c=rel%path.d1;
+                        acc+=path.pw*path.inv_sqrt
+                            *zcache(path.z_base,node,u)
+                            *x1(node,path.in1_off+u*path.d1+c);
+                    }
+                }
+                output(node,column)=acc*mask(column);
+            });
+    }
+}
+
+template<typename Precision>
+void MaceNonlinearKokkosT<Precision>::polar_uvu_gemm_reverse(
+    const int num_nodes,const std::vector<int>& meta,
+    const std::vector<Precision>& path_weight,
+    Kokkos::View<Precision*> weight_view,
+    Kokkos::View<Precision*> mask_view,
