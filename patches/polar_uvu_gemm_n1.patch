+        ensure_view(polar_uvu_p,polar_uvu_p_storage,
+            num_nodes,kPolarUvuGemmWidth);
+        ensure_view(polar_uvu_dx2,polar_uvu_dx2_storage,
+            num_nodes,kPolarUvuGemmWidth);
