+                        Precision mb=Precision(0);
+                        for(int c=0;c<d1;++c) {
+                            const int i1=in1_off+u*d1+c;
+                            const Precision o=out_adj(node,out_off+u*d1+c)
+                                *mask(out_off+u*d1+c);
+                            x1_adj(node,i1)+=pw*inv*mixed*o;
+                            mb+=x1(node,i1)*o;
+                        }
+                        mixed_bar(node,u)=mb;
+                    });
+                Kokkos::parallel_for("polar uvu gemm rev p",
+                    Kokkos::MDRangePolicy<Kokkos::Rank<2>>({0,0},
+                        {num_nodes,mul1}),
+                    KOKKOS_LAMBDA(int node,int u) {
+                        pview(node,u)=pw*inv*mixed_bar(node,u);
+                    });
+                KokkosBlas::gemm("N","N",Precision(1),pview,W,
+                    Precision(0),dx2);
+                Kokkos::parallel_for("polar uvu gemm rev dx2",
+                    Kokkos::MDRangePolicy<Kokkos::Rank<2>>({0,0},
+                        {num_nodes,mul2}),
+                    KOKKOS_LAMBDA(int node,int v) {
+                        x2_adj(node,in2_off+v)+=dx2(node,v);
+                    });
+            }
+            z_offset+=planes;
+        }
+    }
+}
