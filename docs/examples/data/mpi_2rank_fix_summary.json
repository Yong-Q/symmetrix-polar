 "root_causes": {
  "default_2rank_oom": [
   "Exact 2-hop multi-rank graph is large by design: 2481/2581 nodes, 74472/78156 edges per rank.",
   "The materialized reverse kept a second [edges,message_width] buffer (edge_message_adj) while the forward edge_messages storage was dead, and a second [edges,weight_size] buffer (raw_weight_adj) that is just weight_adj scaled by the cutoff.",
   "Those duplicates added 8.9 GiB/rank and pushed the 2-rank peak to 80,966 MiB on an 80 GiB A100."
  ],
  "h1_2rank_segv": [
   "node_feature_width() returned the 512-wide embedding only; the pair style copies it into comm_forward/comm_reverse and LAMMPS sizes its buffers once in Comm::init.",
   "The layer-1 H1 hook exchanges the 2048-wide product-block output, so pack/unpack overran the 512-wide LAMMPS buffers; the same defect surfaced as SIGSEGV on one build and cudaErrorIllegalAddress on the round-3 build."
  ]
 },
